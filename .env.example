# Copy this file to .env and fill in your real API key.
# .env is gitignored, so the key will NOT be committed.
#
# Usage:
#   cp .env.example .env
#   # then edit .env and paste your key after the =

# CSTCloud uni-api (https://uni-api.cstcloud.cn/v1)
# One key serves all models in the gateway (deepseek-v4-flash, deepseek-v3.2,
# minimax-m27, bge-large-zh, ...).
CSTCLOUD_API_KEY=

# Optional: Clarivate Web of Science Starter API key.
# Only needed after enabling a wos_starter source in config/sources.yaml.
WOS_API_KEY=
